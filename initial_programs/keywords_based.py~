def _has(text, subs):
    return any(s in text for s in subs)


def _context(history, text):
    last = last_assistant(history)
    if any(k in text for k in ["вариант 2", "вариант б", "второе", "пункт б"]):
        if _has(last, ["оператор", "специалист", "человек"]):
            return "support"
        if _has(last, ["объясн", "методик", "подробн"]):
            return "technical"
    if any(k in text for k in ["покажи ещё", "покажи еще", "дальше", "следующи"]):
        if _has(last, ["каталог", "витрин", "таблиц", "объект"]):
            return "data_catalog"
        if _has(last, ["методик", "объясн", "тему"]):
            return "technical"
    if "оформи" in text and "таблиц" in text:
        if any(c.isdigit() for c in last) or "равен" in last or "минус" in last:
            return "no_rag"
        if _has(last, ["сводн", "числ"]):
            return "pivot_table"
    if "когда она начинает" in text:
        if any(c.isdigit() for c in last):
            return "no_rag"
        return "technical"
    return None


def entrypoint(history, text):
    t = (text or "").lower()

    ctx = _context(history, t)
    if ctx:
        return {"intent": ctx, "needs_clarification": False}

    if _has(t, SUPPORT):
        if _has(t, SUPPORT_NEG):
            return {"intent": "technical", "needs_clarification": False}
        return {"intent": "support", "needs_clarification": False}

    if _has(t, GREETING) or _has(t, GRATITUDE):
        if _has(t, WORK) or "?" in t:
            return {"intent": "technical", "needs_clarification": False}

    if _has(t, CAPABILITIES):
        return {"intent": "capabilities", "needs_clarification": False}
    if _has(t, PIVOT):
        return {"intent": "pivot_table", "needs_clarification": False}
    if _has(t, CATALOG):
        clar = ("информац" in t or "сведени" in t) and not _has(
            t, ["найди", "покажи", "выведи", "подбери", "где"])
        return {"intent": "data_catalog", "needs_clarification": clar}
    if _has(t, NORAG):
        return {"intent": "no_rag", "needs_clarification": False}
    if _has(t, GRATITUDE):
        return {"intent": "gratitude", "needs_clarification": False}
    if _has(t, GREETING):
        return {"intent": "greeting", "needs_clarification": False}

    return {"intent": "technical", "needs_clarification": False}
